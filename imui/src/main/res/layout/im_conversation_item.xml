<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/im_conversation_avatar"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="会话头像"
        android:src="@drawable/ic_default_avatar" />

    <TextView
        android:id="@+id/im_conversation_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:textColor="#999999"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/im_conversation_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@id/im_conversation_avatar"
        android:layout_toStartOf="@id/im_conversation_time"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#202020"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/im_conversation_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="6dp"
        android:layout_toEndOf="@id/im_conversation_title"
        android:textColor="#999999"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/im_conversation_unread"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_conversation_unread"
        android:gravity="center"
        android:minWidth="20dp"
        android:paddingHorizontal="5dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/im_conversation_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/im_conversation_avatar"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_toEndOf="@id/im_conversation_avatar"
        android:layout_toStartOf="@id/im_conversation_unread"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#888888"
        android:textSize="14sp" />
</RelativeLayout>
