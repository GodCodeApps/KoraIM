<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="150dp"
    android:layout_height="150dp"
    android:background="@drawable/bg_voice_record_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 中间状态图标区域 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 正常录音中（麦克风 + 动态音量柱） -->
        <LinearLayout
            android:id="@+id/ll_recording_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_record_mic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_voice_mic_white" />

            <!-- 6 级音量波形柱 -->
            <LinearLayout
                android:id="@+id/ll_volume_bars"
                android:layout_width="22dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:gravity="bottom"
                android:orientation="vertical">

                <View
                    android:id="@+id/v_bar_6"
                    android:layout_width="22dp"
                    android:layout_height="3dp"
                    android:layout_marginBottom="3dp"
                    android:background="#FFFFFF"
                    android:alpha="0.2" />

                <View
                    android:id="@+id/v_bar_5"
                    android:layout_width="18dp"
                    android:layout_height="3dp"
                    android:layout_marginBottom="3dp"
                    android:background="#FFFFFF"
                    android:alpha="0.2" />

                <View
                    android:id="@+id/v_bar_4"
                    android:layout_width="15dp"
                    android:layout_height="3dp"
                    android:layout_marginBottom="3dp"
                    android:background="#FFFFFF"
                    android:alpha="0.2" />

                <View
                    android:id="@+id/v_bar_3"
                    android:layout_width="12dp"
                    android:layout_height="3dp"
                    android:layout_marginBottom="3dp"
                    android:background="#FFFFFF"
                    android:alpha="0.2" />

                <View
                    android:id="@+id/v_bar_2"
                    android:layout_width="9dp"
                    android:layout_height="3dp"
                    android:layout_marginBottom="3dp"
                    android:background="#FFFFFF"
                    android:alpha="0.2" />

                <View
                    android:id="@+id/v_bar_1"
                    android:layout_width="6dp"
                    android:layout_height="3dp"
                    android:background="#FFFFFF"
                    android:alpha="0.2" />
            </LinearLayout>
        </LinearLayout>

        <!-- 松开取消图标 -->
        <ImageView
            android:id="@+id/iv_record_cancel"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_voice_cancel"
            android:visibility="gone" />

        <!-- 警告图标（如录音时间太短） -->
        <ImageView
            android:id="@+id/iv_record_warning"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_voice_warning_white"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 底部提示文字 -->
    <TextView
        android:id="@+id/tv_record_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp"
        android:text="手指上滑，取消发送"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:fontFamily="sans"
        android:maxLines="1" />
</LinearLayout>
