<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp" android:layout_height="wrap_content"
    android:minHeight="76dp" android:gravity="center_vertical"
    android:orientation="horizontal" android:padding="12dp"
    android:background="@drawable/im_bg_card">

    <ImageView
        android:id="@+id/iv_file_icon"
        android:layout_width="42dp" android:layout_height="42dp"
        android:layout_marginEnd="12dp" android:src="@drawable/ic_file_document"
        android:contentDescription="文件" />

    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_file_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="2" android:ellipsize="end" android:textColor="#222222" android:textSize="15sp" />
        <TextView android:id="@+id/tv_file_size" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:textColor="#888888" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
