<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/imcall_bg_audio">
    <org.webrtc.SurfaceViewRenderer android:id="@+id/imcall_remote" android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <View android:id="@+id/imcall_scrim" android:layout_width="0dp" android:layout_height="0dp" android:background="@drawable/imcall_bg_scrim"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <org.webrtc.SurfaceViewRenderer android:id="@+id/imcall_local" android:layout_width="104dp" android:layout_height="148dp"
        android:layout_marginTop="44dp" android:layout_marginEnd="16dp" android:background="#222222" android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout android:id="@+id/imcall_info" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:gravity="center" android:orientation="vertical" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintVertical_bias="0.29">
        <FrameLayout android:id="@+id/imcall_avatar_container" android:layout_width="92dp" android:layout_height="92dp" android:background="@drawable/imcall_bg_avatar">
            <TextView android:id="@+id/imcall_avatar" android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold" />
            <ImageView android:id="@+id/imcall_avatar_image" android:layout_width="match_parent" android:layout_height="match_parent"
                android:contentDescription="头像" android:scaleType="centerCrop" />
        </FrameLayout>
        <TextView android:id="@+id/imcall_peer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp"
            android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold" />
        <TextView android:id="@+id/imcall_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:textColor="#CCFFFFFF" android:textSize="15sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/imcall_secondary_controls" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="34dp" android:layout_marginBottom="38dp" android:gravity="center" android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/imcall_actions">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageButton android:id="@+id/imcall_mute" android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/imcall_bg_control"
                android:contentDescription="静音" android:padding="16dp" android:src="@drawable/imcall_ic_mic" android:tint="#FFFFFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="静音" android:textColor="#FFFFFF" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageButton android:id="@+id/imcall_speaker" android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/imcall_bg_control"
                android:contentDescription="扬声器" android:padding="16dp" android:src="@drawable/imcall_ic_speaker" android:tint="#FFFFFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="扬声器" android:textColor="#FFFFFF" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/imcall_camera_group" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageButton android:id="@+id/imcall_camera" android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/imcall_bg_control"
                android:contentDescription="切换摄像头" android:padding="16dp" android:src="@drawable/imcall_ic_switch_camera" android:tint="#FFFFFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="切换镜头" android:textColor="#FFFFFF" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/imcall_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="48dp"
        android:gravity="center" android:orientation="horizontal" app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout android:id="@+id/imcall_accept_group" android:layout_width="120dp" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
            <ImageButton android:id="@+id/imcall_accept" android:layout_width="68dp" android:layout_height="68dp" android:background="@drawable/imcall_bg_accept"
                android:contentDescription="接听" android:padding="19dp" android:src="@drawable/imcall_ic_phone" android:tint="#FFFFFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="接听" android:textColor="#FFFFFF" android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/imcall_end_group" android:layout_width="120dp" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
            <ImageButton android:id="@+id/imcall_end" android:layout_width="68dp" android:layout_height="68dp" android:background="@drawable/imcall_bg_end"
                android:contentDescription="挂断" android:padding="19dp" android:rotation="135" android:src="@drawable/imcall_ic_phone" android:tint="#FFFFFF" />
            <TextView android:id="@+id/imcall_end_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="挂断" android:textColor="#FFFFFF" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
