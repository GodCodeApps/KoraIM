<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.KoraIM" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/kora_green</item>
        <item name="colorPrimaryDark">@color/kora_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="Theme.KoraIM" parent="Base.Theme.KoraIM" />

    <style name="Theme.KoraIM.Translucent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>